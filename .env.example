# ---- LLM ------------------------------------------------------------------
# anthropic | openai | fake   (fake = deterministic offline demo, no key needed)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides (defaults: anthropic -> claude-haiku-5-5 / claude-sonnet-5-5, openai -> gpt-4o-mini / gpt-4o)
# ROUTER_MODEL=
# AGENT_MODEL=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# ---- RAG ------------------------------------------------------------------
# fastembed (local multilingual, default in Docker) | openai | hash (tests)
EMBEDDING_BACKEND=fastembed
# Crawl the live URLs in data/sources.yaml when building the index (curated KB is always used)
INGEST_CRAWL=true
RETRIEVAL_TOP_K=5

# ---- Tools ----------------------------------------------------------------
# Optional: Tavily for web search (otherwise DuckDuckGo, no key)
TAVILY_API_KEY=

# ---- Human handoff ----------------------------------------------------------
# Optional Microsoft Teams / Slack incoming webhook to page a human operator
HANDOFF_WEBHOOK_URL=

# ---- Ops ------------------------------------------------------------------
LOG_LEVEL=INFO
EXPOSE_TRACE=true
# LangSmith tracing (optional, native to LangGraph)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=getnet-multi-agent
